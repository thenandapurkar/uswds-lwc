<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>USWDS Step Indicator LWC</masterLabel>
    <description>USWDS Step Indicator with 4 variants: default, centered, counters, and counters-sm. Configurable step labels and current step.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="variant" type="String" label="Variant" datasource="default,centered,counters,counters-sm" default="default" />
            <property name="currentStep" type="Integer" label="Current Step" default="1" />
            <property name="labels" type="String" label="Step Labels (separate with ;)" default="Personal information; Household status; Supporting documents; Signature; Review and submit" />
        </targetConfig>
        <targetConfig targets="lightning__FlowScreen">
            <property name="variant" type="String" label="Variant (default, centered, counters, counters-sm)" default="default" />
            <property name="currentStep" type="Integer" label="Current Step" default="1" />
            <property name="labels" type="String" label="Step Labels (separate with ;)" default="Personal information; Household status; Supporting documents; Signature; Review and submit" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
