<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>USWDS Service Tile LWC</masterLabel>
    <description>Reusable USWDS-styled service tile with SVG icon, label, and link. Use inside any services grid layout.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="label" type="String" label="Service Label" default="Service Name" />
            <property name="url" type="String" label="Service URL" default="#" />
            <property name="icon" type="String" label="Icon Key" description="Icon key from built-in library: report, service, application, complaint, permit, library, water, parking, council, building, parks, animal, payment, health, election, trash" default="service" />
            <property name="compact" type="Boolean" label="Compact Mode" default="false" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
