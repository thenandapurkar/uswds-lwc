<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>USWDS Summary Box LWC</masterLabel>
    <description>USWDS Summary Box. Use the Content (HTML) property for full formatting control (bold, bullets, sizing).</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="heading" type="String" label="Heading" default="Key information" />
            <property name="variant" type="String" label="Color Variant" datasource="cyan,green,purple" default="cyan" />
            <property name="items" type="String" label="Bullet Points (legacy, semicolon-separated)" default="" />
            <property name="richContent" type="String" label="Content (HTML)" default="&lt;ul&gt;&lt;li&gt;Check your bin for tags&lt;/li&gt;&lt;li&gt;Residential properties only&lt;/li&gt;&lt;/ul&gt;" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
