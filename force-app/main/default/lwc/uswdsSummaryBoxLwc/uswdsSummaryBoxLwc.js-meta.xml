<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>USWDS Summary Box LWC</masterLabel>
    <description>USWDS Summary Box with color variants. Drop a Rich Text component inside to format content with bullets, bold, and sizing.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="heading" type="String" label="Heading" default="Key information" />
            <property name="variant" type="String" label="Color Variant" datasource="cyan,green,purple" default="cyan" />
            <property name="items" type="String" label="Bullet Points (legacy - use Rich Text instead)" default="" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
